# --- Supabase ---------------------------------------------------------------
# Project Settings -> API. The anon/public key is safe to expose to the browser
# (it is rate-limited and constrained by Row Level Security).
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# --- App --------------------------------------------------------------------
# Public base URL of the deployment (e.g. https://your-app.vercel.app). Used to
# build absolute password-reset links. Optional locally (falls back to the
# request host); SET it in production.
NEXT_PUBLIC_SITE_URL=

# --- GitHub integration (Pass 5 / Profiles) ---------------------------------
# Classic Personal Access Token with the `read:user` scope. Required because
# the contribution graph is only available via the authenticated GraphQL API.
# Server-side only — never exposed to the browser.
GITHUB_TOKEN=

# --- LeetCode integration (Pass 5 / Profiles) -------------------------------
# No key needed — the public GraphQL endpoint is queried server-side.
